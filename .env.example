# 复制为 .env 后填入真实值；.env 不提交 Git。
ARK_API_KEY=''
DB_PASSWORD=''
# 可选：为不同模型分别设置 CLASSIFY_API_KEY / SUMMARY_API_KEY / EMBEDDING_API_KEY。

# 服务器默认使用 config.py 中的内网新闻接口；本地外网测试时才覆盖。
# NEWS_API_BASE_URL=http://your-server:9999/news_server/api
# DB_HOST=your-db-host
# DB_USER=your-db-user
# DB_DATABASE=spider_news

SCHEDULER_ENABLED=1
STARTUP_DELAY_SECONDS=10
INTERVAL_SECONDS=600
DB_ENABLED=1
MODEL_TIMEOUT=240
BIND=127.0.0.1:2400
